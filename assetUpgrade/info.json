            "parameters": [
                {
                    "title": "Host",
                    "type": "text",
                    "name": "host",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the Hostname of the server to which you will connect and execute commands or python scripts."
                },
                {
                    "title": "Port",
                    "type": "text",
                    "name": "port",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": "22",
                    "tooltip": "Specify the Port number used for connecting to the server."
                },
                {
                    "title": "Timeout",
                    "type": "text",
                    "name": "timeout",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": 10,
                    "tooltip": "Specify the timeout value after which the connection to the server is dropped."
                },
                {
                    "title": "Interactive Mode",
                    "type": "checkbox",
                    "name": "interactive",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": false,
                    "tooltip": "Enable this option to execute a list of commands sequentially in a single session. This mode is necessary to handle interactive prompts, such as \"Do you want to continue? (y/n)\", that may appear during the execution of commands."
                },
                {
                    "title": "Commands",
                    "type": "text",
                    "name": "cmd_list",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the command that to execute on the SSH device. You can provide commands in the .csv or the list format.",
                    "placeholder": "e.g. [\"\\n\",\"copy running-config startup-config\",\"exit\"]"
                },
                {
                    "title": "Wait Time",
                    "type": "text",
                    "name": "wait_time",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": 10,
                    "tooltip": "Specify the wait time for Interactive Command."
                }
            ],
